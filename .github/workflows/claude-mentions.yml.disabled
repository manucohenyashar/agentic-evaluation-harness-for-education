# DISABLED — this harness runs locally, not in GitHub Actions.
#
# GitHub only parses `.yml`/`.yaml` files in this directory, so the
# `.disabled` extension keeps this inert while preserving it as reference.
# Development happens on a developer's machine via `/work-backlog`; GitHub is
# used only to host the repo and the issue graph. Re-enable by renaming back
# to `.yml` — but note that doing so needs an `ANTHROPIC_API_KEY` repo secret
# and will bill API usage rather than a Claude subscription.

name: Claude mentions

# Human-directed, ad hoc help — separate from the dependency-aware
# automation in dispatch-ready-work.yml. Use this to ask Claude a question
# on an issue/PR, or to hand it a one-off task outside the story graph.

on:
  issue_comment:
    types: [created]
  pull_request_review_comment:
    types: [created]

jobs:
  claude-mention:
    if: contains(github.event.comment.body, '@claude')
    runs-on: ubuntu-latest
    permissions:
      contents: write
      pull-requests: write
      issues: write
      id-token: write
      actions: read
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 1
      - uses: anthropics/claude-code-action@v1
        with:
          anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}
